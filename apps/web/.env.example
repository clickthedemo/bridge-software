# Local development must use the local API. The clients append /api/v1 paths.
# This value is shipped to the browser; never put tokens or service keys here.
NEXT_PUBLIC_BRIDGE_API_BASE=http://localhost:4000

# The frontend currently authenticates through the API with credentialed cookies,
# so direct Supabase browser configuration is not required.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Visual direction lock for staging preview sites only.
# Unified review (bridge-connected-signal.netlify.app) must stay on Modern Network.
# NEXT_PUBLIC_DIRECTION_LOCK=network
