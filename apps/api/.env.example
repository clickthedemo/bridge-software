NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DEPLOYMENT_ENVIRONMENT=development
ENABLE_DEVELOPMENT_BOOTSTRAP=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth supplies and validates JWTs; no separate JWT secret is used.
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:3000/login?verified=true
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password

# Database CLI/tooling only; the API runtime uses the Supabase clients above.
DATABASE_URL=

# Server-only Cobalt TIN verification. Test mode uses test=complete.
COBALT_TIN_API_KEY=
COBALT_TIN_LIVE_ENABLED=false

# Required for encrypted EIN storage workflows; generate a base64-encoded 32-byte key.
EIN_ENCRYPTION_KEY=
EIN_ENCRYPTION_KEY_VERSION=1
