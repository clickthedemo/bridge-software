# Application
NODE_ENV=development

# Web
WEB_URL=http://localhost:3000

# API
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
DEPLOYMENT_ENVIRONMENT=development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth supplies and validates JWTs. These redirects must use the local web app.
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:3000/login?verified=true
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/reset-password

# Database
# Used by database tooling, not by the API runtime. Do not point local tooling at production.
DATABASE_URL=

# EIN verification provider
EIN_VERIFICATION_PROVIDER=
EIN_VERIFICATION_API_KEY=

# Server-only EIN encryption (base64-encoded 32-byte key; never expose publicly)
EIN_ENCRYPTION_KEY=
EIN_ENCRYPTION_KEY_VERSION=1
